    <string name="settings_export_dialog_title">Archiv exportieren</string>
    <string name="settings_format_encrypted">Verschlüsselt (.kpvault)</string>
    <string name="settings_format_encrypted_desc">AES-256 mit Passphrase. Empfohlen, wenn die Datei das Gerät verlässt — ohne Passphrase ist sie für niemanden lesbar, auch nicht für dich.</string>
    <string name="settings_format_json">JSON (unverschlüsselt)</string>
    <string name="settings_format_json_desc">Vollständig und wieder importierbar, zusätzlich mit anderen Programmen auswertbar. Der Inhalt steht im Klartext in der Datei.</string>
    <string name="settings_format_csv">CSV (unverschlüsselt)</string>
    <string name="settings_format_csv_desc">Für Tabellenprogramme. Ebenfalls vollständig und wieder importierbar, ebenfalls im Klartext.</string>

