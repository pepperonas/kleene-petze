    <!-- Autostart -->
    <string name="settings_section_autostart">Autostart &amp; Selbstheilung</string>
    <string name="settings_autostart_toggle">Nach Neustart automatisch starten</string>
    <string name="settings_autostart_hint">Verbindet die Erfassung nach einem Neustart, nach einem App-Update und alle 15 Minuten neu. Android trennt den Dienst sonst still — und meldet das nicht.</string>
    <string name="settings_autostart_last_check">Letzte Prüfung: %1$s</string>
    <string name="settings_autostart_overdue">Die Prüfung läuft seit Stunden nicht mehr — das Energiesparen hält die App an. Nimm sie davon aus, sonst kann auch die Erfassung nicht zurückkommen.</string>
    <string name="settings_autostart_battery_exempt">Von Akku-Optimierung ausnehmen</string>

