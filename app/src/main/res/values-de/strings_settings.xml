    <!-- Pictures -->
    <string name="settings_section_images">Bilder</string>
    <string name="settings_images_toggle">Bilder aus Benachrichtigungen sichern</string>
    <string name="settings_images_hint">Kommentare unter Bildern werden immer gesichert — sie sind der Nachrichtentext. Zusätzlich lässt sich die Bildvorschau speichern, die die Benachrichtigung mitbringt. Das ist nicht das Original aus WhatsApp, sondern die kleinere Vorschau; an die Originaldatei kommt keine App heran.</string>
    <string name="settings_images_none">Keine Bilder gespeichert.</string>
    <plurals name="settings_images_stored">
        <item quantity="one">%1$d Bild · %2$s (verschlüsselt in der Datenbank)</item>
        <item quantity="other">%1$d Bilder · %2$s (verschlüsselt in der Datenbank)</item>
    </plurals>
    <string name="settings_images_delete_all">Alle Bilder löschen</string>
    <string name="settings_images_confirm_title">Alle Bilder löschen?</string>
    <plurals name="settings_images_confirm_text">
        <item quantity="one">%1$d gespeichertes Bild (%2$s) wird entfernt. Die Nachrichten und Kommentare bleiben erhalten.</item>
        <item quantity="other">%1$d gespeicherte Bilder (%2$s) werden entfernt. Die Nachrichten und Kommentare bleiben erhalten.</item>
    </plurals>
    <string name="settings_images_confirm_button">Bilder löschen</string>

    <!-- Security -->
    <string name="settings_section_security">Sicherheit</string>
    <string name="settings_biometric_lock">App mit Biometrie sperren</string>
    <string name="settings_security_hint">Daten liegen verschlüsselt (SQLCipher / AES-256) lokal auf dem Gerät.</string>

    <!-- Appearance -->
    <string name="settings_section_appearance">Erscheinungsbild</string>

    <!-- Export & Import -->
    <plurals name="settings_section_export">
        <item quantity="one">Export &amp; Import (%1$d Nachricht)</item>
        <item quantity="other">Export &amp; Import (%1$d Nachrichten)</item>
    </plurals>
    <string name="settings_export_hint">Das ganze Archiv als Datei sichern und wieder einlesen. Verschlüsselung ist optional — verschlüsselt (.kpvault) ist die Datei ohne Passphrase wertlos, JSON und CSV sind lesbar und lassen sich genauso zurückspielen. Gespeicherte Bilder bleiben auf dem Gerät und sind nicht Teil des Exports.</string>
    <string name="settings_export_busy">Wird verarbeitet…</string>
    <string name="settings_export_button">Archiv exportieren…</string>
    <string name="settings_import_button">Aus Datei importieren…</string>
    <string name="settings_import_hint">Ein Import fügt nur hinzu: bereits vorhandene Nachrichten bleiben unverändert, dieselbe Datei zweimal einzulesen ändert nichts.</string>

