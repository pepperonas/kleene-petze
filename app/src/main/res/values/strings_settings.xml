    <!-- Autostart -->
    <string name="settings_section_autostart">Autostart &amp; self-healing</string>
    <string name="settings_autostart_toggle">Start automatically after reboot</string>
    <string name="settings_autostart_hint">Reconnects capture after a reboot, after an app update and every 15 minutes. Otherwise Android silently disconnects the service — and never tells you.</string>
    <string name="settings_autostart_last_check">Last check: %1$s</string>
    <string name="settings_autostart_overdue">The check hasn\'t run for hours — power saving is freezing the app. Exempt it, otherwise capture can\'t come back either.</string>
    <string name="settings_autostart_battery_exempt">Exempt from battery optimization</string>

    <!-- Monitored apps -->
    <string name="settings_section_monitored">Monitored apps</string>
