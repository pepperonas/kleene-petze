    <!-- Export format dialog -->
    <string name="settings_export_dialog_title">Export archive</string>
    <string name="settings_format_encrypted">Encrypted (.kpvault)</string>
    <string name="settings_format_encrypted_desc">AES-256 with a passphrase. Recommended when the file leaves the device — without the passphrase nobody can read it, not even you.</string>
    <string name="settings_format_json">JSON (unencrypted)</string>
    <string name="settings_format_json_desc">Complete and importable again, and it can also be analysed with other programs. The content is stored in plain text in the file.</string>
    <string name="settings_format_csv">CSV (unencrypted)</string>
    <string name="settings_format_csv_desc">For spreadsheet programs. Also complete and importable again, also in plain text.</string>

