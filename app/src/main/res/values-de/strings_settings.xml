    <string name="settings_section_data">Daten</string>
    <string name="settings_clear_all">Alle Daten löschen</string>
    <string name="settings_clear_confirm_title">Alle Daten löschen?</string>
    <plurals name="settings_clear_confirm_text">
        <item quantity="one">Die %1$d gespeicherte Nachricht wird unwiderruflich gelöscht. Dies kann nicht rückgängig gemacht werden.</item>
        <item quantity="other">Alle %1$d gespeicherten Nachrichten werden unwiderruflich gelöscht. Dies kann nicht rückgängig gemacht werden.</item>
    </plurals>
    <string name="settings_clear_confirm_button">Alles löschen</string>

    <!-- Updates / Notes / About -->
    <string name="settings_section_updates">Updates</string>
    <string name="settings_section_notes">Hinweise</string>
    <string name="settings_notes_text">• Sprachnachrichten, Videos und Originaldateien kommen in keiner Benachrichtigung vor und können daher nicht gesichert werden — Bilder nur als Vorschau.\n• Stummgeschaltete Chats und Nachrichten, die du im offenen Chat empfängst, lösen oft keine Benachrichtigung aus und werden daher nicht erfasst.</string>
    <string name="settings_section_about">Über die App</string>
