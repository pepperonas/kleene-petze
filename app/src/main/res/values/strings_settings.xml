    <!-- Pictures -->
    <string name="settings_section_images">Pictures</string>
    <string name="settings_images_toggle">Save pictures from notifications</string>
    <string name="settings_images_hint">Captions under pictures are always saved — they are the message text. In addition, the picture preview that comes with the notification can be kept. It is not the original from WhatsApp but the smaller preview; no app can get at the original file.</string>
    <string name="settings_images_none">No pictures saved.</string>
    <plurals name="settings_images_stored">
        <item quantity="one">%1$d picture · %2$s (encrypted in the database)</item>
        <item quantity="other">%1$d pictures · %2$s (encrypted in the database)</item>
    </plurals>
    <string name="settings_images_delete_all">Delete all pictures</string>
    <string name="settings_images_confirm_title">Delete all pictures?</string>
    <plurals name="settings_images_confirm_text">
        <item quantity="one">%1$d saved picture (%2$s) will be removed. The messages and captions are kept.</item>
        <item quantity="other">%1$d saved pictures (%2$s) will be removed. The messages and captions are kept.</item>
    </plurals>
    <string name="settings_images_confirm_button">Delete pictures</string>

    <!-- Security -->
    <string name="settings_section_security">Security</string>
    <string name="settings_biometric_lock">Lock app with biometrics</string>
    <string name="settings_security_hint">Data is stored encrypted (SQLCipher / AES-256), locally on this device.</string>

    <!-- Appearance -->
    <string name="settings_section_appearance">Appearance</string>

    <!-- Export & Import -->
    <plurals name="settings_section_export">
        <item quantity="one">Export &amp; Import (%1$d message)</item>
        <item quantity="other">Export &amp; Import (%1$d messages)</item>
    </plurals>
    <string name="settings_export_hint">Save the whole archive as a file and read it back in. Encryption is optional — encrypted (.kpvault), the file is worthless without the passphrase; JSON and CSV are readable and can be restored just the same. Saved pictures stay on the device and are not part of the export.</string>
    <string name="settings_export_busy">Processing…</string>
    <string name="settings_export_button">Export archive…</string>
    <string name="settings_import_button">Import from file…</string>
    <string name="settings_import_hint">An import only adds: messages already present stay unchanged, and importing the same file twice changes nothing.</string>

    <!-- Data -->
    <string name="settings_section_data">Data</string>
    <string name="settings_clear_all">Delete all data</string>
    <string name="settings_clear_confirm_title">Delete all data?</string>
    <plurals name="settings_clear_confirm_text">
        <item quantity="one">The %1$d saved message will be permanently deleted. This cannot be undone.</item>
        <item quantity="other">All %1$d saved messages will be permanently deleted. This cannot be undone.</item>
    </plurals>
    <string name="settings_clear_confirm_button">Delete everything</string>

    <!-- Updates / Notes / About -->
    <string name="settings_section_updates">Updates</string>
    <string name="settings_section_notes">Notes</string>
    <string name="settings_notes_text">• Voice messages, videos and original files never appear in a notification and therefore cannot be saved — pictures only as a preview.\n• Muted chats and messages you receive while the chat is open often trigger no notification and are therefore not captured.</string>
    <string name="settings_section_about">About</string>
